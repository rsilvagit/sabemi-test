{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "SimulatedDelayMs": 2000
  },
  "RateLimiting": {
    "Webhook": {
      "TokenLimit": 200,
      "TokensPerPeriod": 50,
      "ReplenishmentPeriodSeconds": 1,
      "QueueLimit": 0
    },
    "Dashboard": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}

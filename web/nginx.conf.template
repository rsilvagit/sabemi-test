server {
    # ${PORT} / ${API_ORIGIN} / ${DASHBOARD_API_KEY} are substituted by the official nginx
    # image's built-in envsubst-on-templates entrypoint (files under
    # /etc/nginx/templates/*.template). It only replaces names that are actually set as
    # environment variables, so nginx's own runtime vars ($host, $uri, ...) below are left
    # untouched.
    #
    # API_ORIGIN must be a plain http:// hostname resolvable at container start — the
    # docker-compose service name locally ("http://api:8080"), or Render's private-network
    # address in production ("http://sabemi-api:10000", see README). Deliberately NOT a
    # public https:// URL: proxying to one from here would mean re-terminating TLS through
    # whatever edge fronts that public host, which needs per-request DNS + explicit SNI and
    # still isn't guaranteed to work (hit a bare "SSL alert handshake failure" against
    # Render's own edge). Private networking sidesteps that entirely — no public hop, no TLS.
    listen ${PORT};

    location /api/ {
        proxy_pass ${API_ORIGIN};
        proxy_set_header Host $host;
        # The dashboard never learns the key — nginx injects it server-side on every
        # proxied request, keeping it out of the JS bundle and swappable per environment
        # (same reasoning as API_ORIGIN above) instead of baked in at `npm run build`. This
        # is the dashboard's own key (Dashboard:ApiKey on the API side) — never the
        # partner bank's webhook key, which the dashboard has no reason to ever hold.
        proxy_set_header X-Api-Key ${DASHBOARD_API_KEY};
    }

    location /webhooks/ {
        proxy_pass ${API_ORIGIN};
        proxy_set_header Host $host;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
